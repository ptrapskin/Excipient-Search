# Copy this file to .env and fill in real values. Never commit .env.

# Cognito Forms API key, scoped Read/Write to the "Drug Donation Record
# Submission" form. Org Settings -> Integrations -> + New API Key.
EXCIPIENT_SEARCH_COGNITO_API_KEY=

# Cognito Forms form ID for "Drug Donation Record Submission".
EXCIPIENT_SEARCH_COGNITO_DONATION_FORM_ID=38
